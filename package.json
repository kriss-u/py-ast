{
	"name": "py-ast",
	"version": "1.14.0",
	"type": "module",
	"description": "A TypeScript library for parsing and walking Python Abstract Syntax Trees",
	"main": "dist/index.cjs",
	"module": "dist/index.esm.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.esm.js",
			"require": "./dist/index.cjs",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "npm run type-check && rollup -c",
		"dev": "rollup -c --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "biome check src/",
		"lint:fix": "biome check src/ --write",
		"format": "biome format --write",
		"type-check": "node node_modules/typescript/bin/tsc --noEmit",
		"clean": "rimraf dist",
		"prepare": "husky",
		"demo": "node demo/ast-demo.mjs",
		"demo:test": "node demo/test-suite.mjs",
		"demo:interactive": "node demo/interactive.mjs",
		"demo:json": "node demo/json-examples.mjs",
		"demo:all": "npm run demo && npm run demo:test",
		"py2json": "node demo/py2json.mjs",
		"corpus": "node scripts/corpus/run.mjs",
		"corpus:roundtrip": "node scripts/corpus/roundtrip.mjs",
		"release": "semantic-release",
		"release:dry": "semantic-release --dry-run",
		"release:local": "node scripts/release-local.mjs",
		"release:local:dry": "node scripts/release-local.mjs --dry-run",
		"jsr:sync": "node scripts/jsr-release.mjs",
		"jsr:publish": "npm run jsr:sync && npx jsr publish --allow-slow-types",
		"docs": "npm --prefix docs-tooling install && npm --prefix docs-tooling run build",
		"playground": "npm --prefix playground install && npm --prefix playground run dev",
		"playground:build": "npm --prefix playground install && npm --prefix playground run build"
	},
	"keywords": [
		"python",
		"ast",
		"parser",
		"syntax-tree",
		"typescript"
	],
	"author": "Krishna Upadhyay",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/kriss-u/py-ast.git"
	},
	"bugs": {
		"url": "https://github.com/kriss-u/py-ast/issues"
	},
	"homepage": "https://github.com/kriss-u/py-ast#readme",
	"devDependencies": {
		"@biomejs/biome": "2.1.3",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@rollup/plugin-commonjs": "^28.0.0",
		"@rollup/plugin-node-resolve": "^16.0.0",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^11.0.3",
		"@types/node": "^22.20.1",
		"@typescript/typescript6": "^6.0.2",
		"@vitest/coverage-v8": "^4.1.10",
		"esbuild": "^0.28.2",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.2",
		"rimraf": "^5.0.0",
		"rollup": "^4.0.0",
		"rollup-plugin-dts": "^6.5.1",
		"rollup-plugin-esbuild": "^6.2.1",
		"semantic-release": "^25.0.9",
		"tslib": "^2.6.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"overrides": {
		"glob": "^10.0.0",
		"inflight": "npm:@isaacs/noop@1.0.0"
	},
	"lint-staged": {
		"src/**/*.ts": "biome check --write",
		"!(package-lock).json": "biome format --write"
	}
}
